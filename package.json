{
  "name": "climbpose-lab",
  "version": "0.3.0-dev",
  "private": true,
  "type": "module",
  "description": "Climbing movement analysis in the browser: pose, attempts, crux breakdown, body load.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "vitest run tests/eval --reporter=verbose",
    "lint:layers": "node tools/check-layers.mjs",
    "golden:update": "vite-node tools/update-golden.ts",
    "build:single": "vite build --mode single",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.14",
    "mp4-muxer": "5.1.3"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "2.1.8",
    "@types/node": "22.10.1"
  }
}
